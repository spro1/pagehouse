# Pagehouse settings. The installer creates .env from this file with a random password.
# Restart after changes: docker compose up -d

# Database password. Set before the first start; changing it later also needs a change inside Postgres.
POSTGRES_PASSWORD=change-me
# Encrypts stored secrets (SSO client secret). The installer generates it; backups don't include it, so keep this file.
SECRET_KEY=

# Web port on this machine, and the address to listen on (127.0.0.1 = only reachable through a local reverse proxy).
PORT=3000
BIND_ADDRESS=0.0.0.0

# 1 lets anyone who can reach the site create an account. Keep 0 and use invite links.
ALLOW_SIGNUP=0

# Address people use to reach the wiki, e.g. https://wiki.example.com (used for sign-on redirects and links in email).
PUBLIC_URL=

# Number of reverse proxies in front (nginx, Caddy, a load balancer). Set 1 behind one proxy so sign-in throttling
# and the audit log see real client addresses; keep 0 when people connect to this server directly.
TRUST_PROXY=0

# Single sign-on with OpenID Connect (Keycloak, Entra ID, Google Workspace, Okta...). Leave OIDC_ISSUER empty to turn off.
# Register the redirect URI <PUBLIC_URL>/api/auth/oidc/callback at the provider.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL=Company SSO
# 1 creates an account on first sign-on; 0 only lets in people who already have an account with that email.
OIDC_AUTO_CREATE=1
# Accounts are matched by email, so only emails the provider marks verified are accepted. 1 also accepts providers
# that never send email_verified (some Entra ID setups) — only if users can't change their own email there.
OIDC_TRUST_EMAIL=0
# 0 hides password sign-in for everyone but administrators (their way in if the provider is down).
PASSWORD_LOGIN=1
# Claim with the person's groups at the provider; copied to wiki groups at each sign-in. Members of OIDC_ADMIN_GROUP become admins.
OIDC_GROUPS_CLAIM=groups
OIDC_ADMIN_GROUP=
# API tokens of SSO users stop after this many days without an SSO sign-in.
TOKEN_SSO_GRACE_DAYS=30

# Token for creating the first (administrator) account. Empty = one is generated and printed in the log.
SETUP_TOKEN=
# How long a sign-in lasts, in hours (24 = one day; 720 = 30 days, the default before 0.5.0).
SESSION_HOURS=24

# Email (optional) for notifications and "Forgot your password?" reset links, e.g. smtp://user:password@mail.example.com:587 or smtps://...:465.
SMTP_URL=
SMTP_FROM=Pagehouse <wiki@example.com>

# Link cards: the server fetches a pasted link's title and image. 0 turns it off. Internal addresses are refused
# unless listed here, e.g. jira.corp.local,.gitlab.corp.local (a leading dot allows every subdomain).
LINK_PREVIEW=1
LINK_PREVIEW_ALLOW=
# Internal hosts that personal notification webhooks may reach, e.g. chat.corp.local,.corp.local (admin webhooks may reach any host)
WEBHOOK_ALLOW=
# Turns on /metrics for Prometheus; scrapers send it as a bearer token. Empty = off.
METRICS_TOKEN=

# Image version to run. Upgrades change this (scripts/upgrade.sh does it for you).
PAGEHOUSE_VERSION=latest

# Automatic backups into ./backups: how often, and how many to keep.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# Building from source instead of pulling the image? Uncomment:
# COMPOSE_FILE=docker-compose.yml:docker-compose.build.yml
