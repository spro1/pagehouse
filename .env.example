# Pagehouse settings. The installer creates .env from this file with a random password.
# Restart after changes: docker compose up -d

# Database password. Set before the first start; changing it later also needs a change inside Postgres.
POSTGRES_PASSWORD=change-me

# Web port on this machine, and the address to listen on (127.0.0.1 = only reachable through a local reverse proxy).
PORT=3000
BIND_ADDRESS=0.0.0.0

# 1 lets anyone who can reach the site create an account. Keep 0 and use invite links.
ALLOW_SIGNUP=0

# Address people use to reach the wiki, e.g. https://wiki.example.com (used for sign-on redirects and links in email).
PUBLIC_URL=

# Single sign-on with OpenID Connect (Keycloak, Entra ID, Google Workspace, Okta...). Leave OIDC_ISSUER empty to turn off.
# Register the redirect URI <PUBLIC_URL>/api/auth/oidc/callback at the provider.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL=Company SSO
# 1 creates an account on first sign-on; 0 only lets in people who already have an account with that email.
OIDC_AUTO_CREATE=1
# 0 hides password sign-in for everyone but administrators (their way in if the provider is down).
PASSWORD_LOGIN=1

# Email for notifications (optional), e.g. smtp://user:password@mail.example.com:587 or smtps://...:465.
SMTP_URL=
SMTP_FROM=Pagehouse <wiki@example.com>

# Link cards: the server fetches a pasted link's title and image. 0 turns it off. Internal addresses are refused
# unless listed here, e.g. jira.corp.local,.gitlab.corp.local (a leading dot allows every subdomain).
LINK_PREVIEW=1
LINK_PREVIEW_ALLOW=

# Image version to run. Upgrades change this (scripts/upgrade.sh does it for you).
PAGEHOUSE_VERSION=latest

# Automatic backups into ./backups: how often, and how many to keep.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# Building from source instead of pulling the image? Uncomment:
# COMPOSE_FILE=docker-compose.yml:docker-compose.build.yml
