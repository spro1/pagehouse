# Pagehouse settings. The installer creates .env from this file with a random password.
# Restart after changes: docker compose up -d

# Database password. Set before the first start; changing it later also needs a change inside Postgres.
POSTGRES_PASSWORD=change-me

# Web port on this machine, and the address to listen on (127.0.0.1 = only reachable through a local reverse proxy).
PORT=3000
BIND_ADDRESS=0.0.0.0

# 1 lets anyone who can reach the site create an account. Keep 0 and use invite links.
ALLOW_SIGNUP=0

# Image version to run. Upgrades change this (scripts/upgrade.sh does it for you).
PAGEHOUSE_VERSION=latest

# Automatic backups into ./backups: how often, and how many to keep.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# Building from source instead of pulling the image? Uncomment:
# COMPOSE_FILE=docker-compose.yml:docker-compose.build.yml
